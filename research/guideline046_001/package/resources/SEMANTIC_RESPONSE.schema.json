            "partial",
            "held"
          ]
        },
        "values": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number",
              "null"
            ]
          },
          "minItems": 17,
          "maxItems": 17
        },
        "proofs": {
          "type": "object",
          "properties": {
