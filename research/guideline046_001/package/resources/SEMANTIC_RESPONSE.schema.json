      "type": "object",
      "properties": {
        "refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(cell|context):[^\\s]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "transformation": {
          "type": "string",
          "minLength": 1
        },
        "role_basis": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "refs",
        "transformation",
        "role_basis"
      ],
      "additionalProperties": false
    },
    "null_proof": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "reason"
      ],
      "additionalProperties": false
    },
    "raw_selection": {
      "type": "object",
