{
 "type": "object",
 "properties": {
  "schema": {
   "const": "cps.source-inventory.cells.v2"
  },
  "case_id": {
   "type": "string",
   "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
  },
  "family_id": {
   "type": "string",
   "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
  },
  "representation_profile": {
   "const": "cached-cell-raw-scalar-text.v2"
  },
  "source": {
   "type": "object",
   "properties": {
    "source_id": {
     "const": "S"
    },
    "format": {
     "enum": [
      "cached_xls",
      "cached_xlsx"
     ]
    },
    "bytes": {
     "type": "integer",
     "minimum": 1
    },
    "sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "adoption_status": {
     "enum": [
      "verified",
      "partial",
      "unverified"
     ]
    },
    "adoption_basis": {
     "type": "string",
     "minLength": 1,
     "maxLength": 30000
    },
    "reader": {
     "type": "object",
     "properties": {
      "name": {
       "type": "string",
       "minLength": 1,
       "maxLength": 30000
      },
      "version": {
       "type": "string",
       "minLength": 1,
       "maxLength": 30000
      },
      "biff_format": {
       "type": [
        "string",
        "null"
       ],
       "maxLength": 30000
      },
      "formula_expressions_available": {
       "type": "boolean"
      }
     },
     "required": [
      "name",
      "version",
      "biff_format",
      "formula_expressions_available"
     ],
     "additionalProperties": false
    },
    "carrier_source": {
     "type": "object",
     "properties": {
      "kind": {
       "enum": [
        "cached_xls",
        "cached_xlsx"
       ]
      },
      "path": {
       "type": "string",
       "minLength": 1,
       "maxLength": 30000
      },
      "sha256": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      },
      "views": {
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "id": {
          "type": "integer",
          "minimum": 1
         },
         "sheet": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30000
         },
         "range": {
          "type": "string",
          "pattern": "^[A-Z]{1,3}[1-9][0-9]*(:[A-Z]{1,3}[1-9][0-9]*)?$"
         }
        },
        "required": [
         "id",
         "sheet",
         "range"
        ],
        "additionalProperties": false
       },
       "minItems": 1
      }
     },
     "required": [
      "kind",
      "path",
      "sha256",
      "views"
     ],
     "additionalProperties": false
    }
   },
   "required": [
    "source_id",
    "format",
    "bytes",
    "sha256",
    "adoption_status",
    "adoption_basis",
    "reader",
    "carrier_source"
   ],
   "additionalProperties": false
  },
  "sheets": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "index": {
      "type": "integer",
      "minimum": 1
     },
     "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30000
     },
     "visibility": {
      "enum": [
       "visible",
       "hidden",
       "very_hidden"
      ]
     },
     "rows": {
      "type": "integer",
      "minimum": 0
     },
     "columns": {
      "type": "integer",
      "minimum": 0
     },
     "merges": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "formula_records": {
      "type": "integer",
      "minimum": 0
     },
     "in_scope": {
      "type": "boolean"
     }
    },
    "required": [
     "index",
     "name",
     "visibility",
     "rows",
     "columns",
     "merges",
     "formula_records",
     "in_scope"
    ],
    "additionalProperties": false
   },
   "minItems": 1
  },
  "views": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "integer",
      "minimum": 1
     },
     "sheet": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30000
     },
     "range": {
      "type": "string",
      "pattern": "^[A-Z]{1,3}[1-9][0-9]*(:[A-Z]{1,3}[1-9][0-9]*)?$"
     },
     "image": {
      "type": "object",
      "properties": {
       "file": {
        "type": "string",
        "minLength": 1,
        "maxLength": 30000
       },
       "bytes": {
        "type": "integer",
        "minimum": 1
       },
       "sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
       }
      },
      "required": [
       "file",
       "bytes",
       "sha256"
      ],
      "additionalProperties": false
     }
    },
    "required": [
     "id",
     "sheet",
     "range",
     "image"
    ],
    "additionalProperties": false
   },
   "minItems": 1
  },
  "external_links": {
   "type": "array",
   "items": {
    "type": "object"
   }
  },
  "cells": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "ref": {
      "type": "string",
      "pattern": "^cell:S[1-9][0-9]{0,3}![A-Z]{1,3}[1-9][0-9]{0,6}$"
     },
     "sheet_index": {
      "type": "integer",
      "minimum": 1
     },
     "sheet": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30000
     },
     "address": {
      "type": "string",
      "pattern": "^[A-Z]{1,3}[1-9][0-9]{0,6}$"
     },
     "row": {
      "type": "integer",
      "minimum": 1
     },
     "col": {
      "type": "integer",
      "minimum": 1
     },
     "saved_type": {
      "enum": [
       "empty",
       "blank",
       "text",
       "number",
       "date",
       "boolean",
       "error"
      ]
     },
     "state": {
      "enum": [
       "literal",
       "cached_formula",
       "true_blank",
       "explicit_empty",
       "covered",
       "error",
       "missing_cache",
       "unresolved"
      ]
     },
     "saved_value": {
      "type": [
       "string",
       "number",
       "boolean",
       "null"
      ]
     },
     "native_literal": {
      "type": [
       "string",
       "null"
      ],
      "maxLength": 30000
     },
     "formula_record_present": {
      "type": "boolean"
     },
     "formula": {
      "type": [
       "string",
       "null"
      ],
      "maxLength": 30000
     },
     "merge_anchor_ref": {
      "anyOf": [
       {
        "type": "string",
        "pattern": "^cell:S[1-9][0-9]{0,3}![A-Z]{1,3}[1-9][0-9]{0,6}$"
       },
       {
        "type": "null"
       }
      ]
     },
     "conflicts": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1,
       "maxLength": 30000
      }
     },
     "canonical_raw": {
      "type": [
       "string",
       "null"
      ],
      "maxLength": 30000
     },
     "usable_for_raw": {
      "type": "boolean"
     },
     "raw_limit_reason": {
      "type": [
       "string",
       "null"
      ],
      "maxLength": 30000
     },
     "views": {
      "type": "array",
      "items": {
       "type": "integer",
       "minimum": 1
      }
     }
    },
    "required": [
     "ref",
     "sheet_index",
     "sheet",
     "address",
     "row",
     "col",
     "saved_type",
     "state",
     "saved_value",
     "native_literal",
     "formula_record_present",
     "formula",
     "merge_anchor_ref",
     "conflicts",
     "canonical_raw",
     "usable_for_raw",
     "raw_limit_reason",
     "views"
    ],
    "additionalProperties": false
   },
   "minItems": 1
  },
  "context_facts": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "ref": {
      "type": "string",
      "pattern": "^context:[a-z0-9_]{1,64}$"
     },
     "namespace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30000
     },
     "value": {
      "type": [
       "string",
       "number",
       "null"
      ]
     },
     "basis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30000
     },
     "authority_pins": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "label": {
         "type": "string",
         "minLength": 1,
         "maxLength": 30000
        },
        "sha256": {
         "type": "string",
         "pattern": "^[0-9a-f]{64}$"
        }
       },
       "required": [
        "label",
        "sha256"
       ],
       "additionalProperties": false
      },
      "minItems": 1
     }
    },
    "required": [
     "ref",
     "namespace",
     "value",
     "basis",
     "authority_pins"
    ],
    "additionalProperties": false
   }
  },
  "limitations": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1,
    "maxLength": 30000
   }
  }
 },
 "required": [
  "schema",
  "case_id",
  "family_id",
  "representation_profile",
  "source",
  "sheets",
  "views",
  "external_links",
  "cells",
  "context_facts",
  "limitations"
 ],
 "additionalProperties": false,
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:cps:source-inventory:cells:v2",
 "description": "Candidate 046b complete positional inventory of one pinned cached workbook. Every physical position of every in-scope sheet appears once; carrier_source is copied verbatim into the writer carrier; the inventory file sha256 binds a response. Structural contract only."
}
